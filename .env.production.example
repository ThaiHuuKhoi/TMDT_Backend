SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# === CORS & COOKIE ===
APP_CORS_ALLOWED_ORIGINS=https://your-client.vercel.app,https://your-admin.vercel.app
APP_SECURITY_COOKIES_SECURE=true
APP_SECURITY_REFRESH_COOKIE_SAME_SITE=None
APP_FRONTEND_OAUTH2_REDIRECT_URI=https://your-client.vercel.app/oauth2/redirect
APP_SECURITY_OAUTH2_AUTHORIZED_REDIRECT_URIS=https://your-client.vercel.app/oauth2/redirect
APP_FRONTEND_URL=https://your-client.vercel.app

# === DATABASE (Railway MySQL) ===
DB_URL=jdbc:mysql://your-railway-mysql-host:3306/railway
DB_USERNAME=root
DB_PASSWORD=your-db-password
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# === REDIS (Upstash) ===
REDIS_HOST=your-upstash-redis-host.upstash.io
REDIS_PORT=6379
# Upstash requires TLS — thêm vào application-prod.properties nếu cần

# === JWT (sinh key mới bằng: openssl rand -base64 64) ===
JWT_SECRET=your-new-strong-secret-key-base64
JWT_EXPIRATION=36000000
JWT_REFRESH_EXPIRATION=604800000

# === OAUTH2 ===
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_FACEBOOK_CLIENT_ID=your-facebook-client-id
OAUTH_FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# === MAIL ===
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# === VNPAY ===
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-client.vercel.app/payment/vnpay-return

# === RATE LIMITING ===
APP_SECURITY_REGISTRATION_OTP_EXPIRATION_MINUTES=10
APP_SECURITY_REGISTRATION_RL_EMAIL_PER_HOUR=5
APP_SECURITY_REGISTRATION_RL_IP_PER_HOUR=30
APP_SECURITY_REGISTRATION_RL_VERIFY_IP_PER_HOUR=80
APP_SECURITY_REGISTRATION_OTP_MAX_FAILS=5
APP_SECURITY_REGISTRATION_OTP_FAIL_WINDOW_MINUTES=15
APP_CHATBOT_RL_IP_PER_MIN=30
APP_CHATBOT_RL_USER_PER_MIN=60
APP_SHIPPING_DEFAULT_FEE_VND=20000
APP_SHIPPING_GRAMS_PER_UNIT=500
